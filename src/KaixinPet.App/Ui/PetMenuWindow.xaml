<Window x:Class="KaixinPet.App.Ui.PetMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="开心菜单"
        Width="264"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        Topmost="True"
        Focusable="False"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        FontFamily="{DynamicResource UiFont}"
        FontSize="12"
        Foreground="{DynamicResource FurInkBrush}">

    <Border x:Name="MenuFrame"
            Background="{DynamicResource PaperCardBrush}"
            BorderBrush="{DynamicResource FurOutlineSoftBrush}"
            BorderThickness="1"
            CornerRadius="14">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="4" Direction="270"
                              Opacity="0.12" Color="#453F33" />
        </Border.Effect>
        <Grid>
            <Border CornerRadius="14" Background="{DynamicResource PaperTextureBrush}"
                    Opacity="0.65" IsHitTestVisible="False" />
            <StackPanel Margin="9">

                <StackPanel Orientation="Horizontal" Margin="9,9,9,11">
                    <Path Data="M4,8 L4,3 L9,6 C10.9,5.2 13.1,5.2 15,6 L20,3 L20,8 C21.3,9.6 22,11.6 22,13.5 C22,17.6 17.5,21 12,21 C6.5,21 2,17.6 2,13.5 C2,11.6 2.7,9.6 4,8 Z M8.5,12 L8.6,12 M15.4,12 L15.5,12 M12,13.4 L12,15 M10.2,16.4 C11,17.2 13,17.2 13.8,16.4 M6,13 L3,12 M6,15 L3.4,16.2 M18,13 L21,12 M18,15 L20.6,16.2"
                          Style="{DynamicResource CatIcon}" />
                    <TextBlock x:Name="MenuStatusText" Text="开心 · 空闲"
                               FontSize="12" Foreground="{DynamicResource FurMutedBrush}"
                               Margin="9,0,0,0" VerticalAlignment="Center"
                               TextWrapping="Wrap" />
                </StackPanel>

                <Border x:Name="TimerGroup" Background="{DynamicResource EyeWashBrush}"
                        CornerRadius="10" Padding="6">
                    <StackPanel>
                        <StackPanel x:Name="TimerIdleGroup">
                            <Button x:Name="StartFocusButton" Style="{DynamicResource MenuButton}"
                                    AutomationProperties.Name="开始专注"
                                    Click="OnStartFocusClicked">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M8,5 L19,12 L8,19 Z" Style="{DynamicResource SolidIcon}"  />
                                    <TextBlock x:Name="StartFocusText" Text="开始专注 · 25 分钟"
                                               Margin="10,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="StartBreakButton" Style="{DynamicResource MenuButton}"
                                    AutomationProperties.Name="开始休息"
                                    Click="OnStartBreakClicked">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M4,13 A8,8 0 0 1 20,13 A8,8 0 0 1 4,13 M12,9 L12,13 L15,15 M9,2 L15,2 M12,2 L12,5"
                                          Style="{DynamicResource LineIcon}"  />
                                    <TextBlock x:Name="StartBreakText" Text="休息 · 5 分钟"
                                               Margin="10,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <StackPanel x:Name="TimerActiveGroup" Visibility="Collapsed">
                            <Button Style="{DynamicResource MenuButton}" Click="OnPauseResumeClicked"
                                    AutomationProperties.Name="暂停或继续">
                                <StackPanel Orientation="Horizontal">
                                    <Path x:Name="PauseIcon" Data="M8,5 L8,19 M16,5 L16,19"
                                          Style="{DynamicResource LineIcon}"  />
                                    <TextBlock x:Name="PauseResumeText" Text="暂停计时"
                                               Margin="10,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Style="{DynamicResource MenuButton}" Click="OnSkipClicked"
                                    AutomationProperties.Name="跳过当前阶段">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M5,5 L15,12 L5,19 Z M18,5 L18,19"
                                          Style="{DynamicResource SolidIcon}"  />
                                    <TextBlock Text="跳过当前阶段" Margin="10,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Style="{DynamicResource MenuButton}" Click="OnResetClicked"
                                    AutomationProperties.Name="结束当前阶段">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M6,6 L18,6 L18,18 L6,18 Z"
                                          Style="{DynamicResource LineIcon}"  />
                                    <TextBlock x:Name="ResetText" Text="结束本次专注"
                                               Margin="10,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{DynamicResource MenuSeparator}" />

                <Button x:Name="PlayButton" Style="{DynamicResource MenuButton}" Click="OnPlayClicked"
                        AutomationProperties.Name="陪它玩毛线球">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M12,4 A8,8 0 0 1 20,12 A8,8 0 0 1 12,20 A8,8 0 0 1 4,12 A8,8 0 0 1 12,4 M7,7 C12,7 16,11 16,16 M5,12 C9,12 12,15 12,19 M12,4 C11,9 14,12 19,12"
                              Style="{DynamicResource LineIcon}"  />
                        <TextBlock x:Name="PlayButtonText" Text="陪它玩毛线球"
                                   Margin="10,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button x:Name="SleepButton" Style="{DynamicResource MenuButton}" Click="OnSleepClicked"
                        AutomationProperties.Name="让它睡觉">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M20,15 A8,8 0 0 1 9,4 A8,8 0 1 0 20,15 Z"
                              Style="{DynamicResource LineIcon}"  />
                        <TextBlock x:Name="SleepButtonText" Text="让它睡觉"
                                   Margin="10,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Border Style="{DynamicResource MenuSeparator}" />

                <Button Style="{DynamicResource MenuButton}" Click="OnTopmostClicked"
                        AutomationProperties.Name="始终置顶">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Path Data="M9,3 L15,3 L14,8 L19,13 L5,13 L10,8 Z M12,13 L12,21"
                              Style="{DynamicResource LineIcon}"  />
                        <TextBlock Grid.Column="1" Text="始终置顶" Margin="10,0,0,0" VerticalAlignment="Center" />
                        <Path x:Name="TopmostCheckMark" Grid.Column="2" Data="M5,12 L10,17 L19,7"
                              Style="{DynamicResource CheckIcon}" Visibility="Collapsed" />
                    </Grid>
                </Button>
                <Button Style="{DynamicResource MenuButton}" Click="OnResetPositionClicked"
                        AutomationProperties.Name="重置位置">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M4,10 A8,8 0 1 1 6,17 M4,4 L4,10 L10,10"
                              Style="{DynamicResource LineIcon}"  />
                        <TextBlock Text="重置位置" Margin="10,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Style="{DynamicResource MenuButton}" Click="OnHideClicked"
                        AutomationProperties.Name="隐藏桌宠">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M2,12 C5,7 9,6 12,6 C15,6 19,7 22,12 C19,17 15,18 12,18 C9,18 5,17 2,12 Z M12,9.5 A2.5,2.5 0 1 1 11.99,9.5"
                              Style="{DynamicResource LineIcon}"  />
                        <TextBlock Text="隐藏桌宠" Margin="10,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Border Style="{DynamicResource MenuSeparator}" />

                <Button Style="{DynamicResource MenuButton}" Click="OnSettingsClicked"
                        AutomationProperties.Name="打开设置">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M4,12 A8,8 0 0 1 20,12 A8,8 0 0 1 4,12 M12,9 L12,12 L14,14 M12,2 L12,4 M12,20 L12,22 M2,12 L4,12 M20,12 L22,12 M5,5 L6.5,6.5 M17.5,17.5 L19,19 M19,5 L17.5,6.5 M6.5,17.5 L5,19"
                              Style="{DynamicResource LineIcon}"  />
                        <TextBlock Text="设置…" Margin="10,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Style="{DynamicResource MenuButton}" Click="OnMuteClicked"
                        AutomationProperties.Name="静音">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Path Data="M5,9 L9,9 L14,5 L14,19 L9,15 L5,15 Z M17,9 C18.5,10.5 18.5,13.5 17,15 M19,6 C22,9 22,15 19,18"
                              Style="{DynamicResource LineIcon}"  />
                        <TextBlock Grid.Column="1" Text="静音" Margin="10,0,0,0" VerticalAlignment="Center" />
                        <Path x:Name="MuteCheckMark" Grid.Column="2" Data="M5,12 L10,17 L19,7"
                              Style="{DynamicResource CheckIcon}" Visibility="Collapsed" />
                    </Grid>
                </Button>

                <Border Style="{DynamicResource MenuSeparator}" />

                <Button Style="{DynamicResource MenuButton}" Click="OnOpenLogsClicked"
                        AutomationProperties.Name="打开日志目录">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M3,6 L10,6 L12,8 L21,8 L21,19 L3,19 Z"
                              Style="{DynamicResource LineIcon}"  />
                        <TextBlock Text="打开日志目录" Margin="10,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Style="{DynamicResource MenuButton}" Click="OnExitClicked"
                        AutomationProperties.Name="退出">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M6,6 L18,6 L18,18 L6,18 Z"
                              Style="{DynamicResource LineIcon}"  />
                        <TextBlock Text="退出" Margin="10,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
