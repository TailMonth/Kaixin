<Window x:Class="KaixinPet.App.Ui.TimeTagWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="开心计时"
        Width="56" Height="22"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        Topmost="True"
        Focusable="False"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">

    <Border x:Name="TagBorder"
            CornerRadius="6"
            Background="#F2F7F2E8"
            BorderBrush="#1A2B2A27"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="8" ShadowDepth="1" Direction="270"
                              Opacity="0.16" Color="#000000" />
        </Border.Effect>

        <Grid Margin="8,0,6,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Width="9" Margin="0,0,5,0" VerticalAlignment="Center">
                <Ellipse x:Name="PhaseDot"
                         Width="4" Height="4"
                         Fill="#E4572E"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center" />
                <StackPanel x:Name="PauseGlyph"
                            Orientation="Horizontal"
                            Visibility="Collapsed"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <Border Width="2" Height="7" Background="#6F6A61" Margin="0,0,1,0" />
                    <Border Width="2" Height="7" Background="#6F6A61" />
                </StackPanel>
            </Grid>

            <TextBlock x:Name="TimeText"
                       Grid.Column="1"
                       Text="25:00"
                       FontFamily="Segoe UI Variable Display, Segoe UI"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="#2B2A27"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       TextOptions.TextFormattingMode="Display"
                       TextOptions.TextRenderingMode="Grayscale"
                       Typography.NumeralAlignment="Tabular"
                       Typography.NumeralStyle="Lining" />
        </Grid>
    </Border>
</Window>
