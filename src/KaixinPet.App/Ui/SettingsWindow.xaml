<Window x:Class="KaixinPet.App.Ui.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="开心 · 设置"
        Width="864" Height="644"
        MinWidth="704" MinHeight="524"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen"
        FontFamily="{DynamicResource UiFont}"
        FontSize="13"
        Foreground="{DynamicResource FurInkBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="Grayscale"
        PreviewKeyDown="OnWindowPreviewKeyDown"
        Loaded="OnWindowLoaded">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="42"
                            ResizeBorderThickness="8"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Grid x:Name="OuterRoot" Margin="12">
        <Border x:Name="WindowFrame"
                CornerRadius="12"
                Background="{DynamicResource PaperWindowBrush}"
                BorderBrush="{DynamicResource FurOutlineBrush}"
                BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect x:Name="WindowShadow" BlurRadius="24" ShadowDepth="6"
                                  Direction="270" Opacity="0.12" Color="#453F33" />
            </Border.Effect>

            <Grid>
                <Border CornerRadius="12" Background="{DynamicResource PaperWindowBrush}" />
                <Border CornerRadius="12" Background="{DynamicResource PaperTextureBrush}"
                        Opacity="0.7" IsHitTestVisible="False" />

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="42" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Title bar -->
                    <Grid Grid.Row="0" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                            <Path Data="M4,8 L4,3 L9,6 C10.9,5.2 13.1,5.2 15,6 L20,3 L20,8 C21.3,9.6 22,11.6 22,13.5 C22,17.6 17.5,21 12,21 C6.5,21 2,17.6 2,13.5 C2,11.6 2.7,9.6 4,8 Z M8.5,12 L8.6,12 M15.4,12 L15.5,12 M12,13.4 L12,15 M10.2,16.4 C11,17.2 13,17.2 13.8,16.4 M6,13 L3,12 M6,15 L3.4,16.2 M18,13 L21,12 M18,15 L20.6,16.2"
                                  Style="{DynamicResource CatIcon}" />
                            <TextBlock Text="开心 · 设置" FontSize="12" FontWeight="SemiBold"
                                       VerticalAlignment="Center" Margin="8,0,0,0" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    shell:WindowChrome.IsHitTestVisibleInChrome="True">
                            <Button x:Name="MinimizeButton" Style="{DynamicResource WindowButton}"
                                    ToolTip="最小化" AutomationProperties.Name="最小化"
                                    Click="OnMinimizeClicked">
                                <Path Data="M6,12 L18,12" Style="{DynamicResource LineIcon}" />
                            </Button>
                            <Button x:Name="MaximizeButton" Style="{DynamicResource WindowButton}"
                                    ToolTip="最大化" AutomationProperties.Name="最大化"
                                    Click="OnMaximizeClicked">
                                <Path x:Name="MaximizeIcon" Data="M6,6 L18,6 L18,18 L6,18 Z"
                                      Style="{DynamicResource LineIcon}" />
                            </Button>
                            <Button x:Name="CloseButton" Style="{DynamicResource WindowButton}"
                                    ToolTip="关闭" AutomationProperties.Name="关闭"
                                    Click="OnCloseClicked">
                                <Path Data="M6,6 L18,18 M18,6 L6,18" Style="{DynamicResource LineIcon}" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="176" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Sidebar -->
                        <Border Grid.Column="0"
                                Background="{DynamicResource PaperSidebarBrush}"
                                BorderBrush="{DynamicResource FurOutlineSoftBrush}"
                                BorderThickness="0,0,1,0">
                            <DockPanel Margin="0,24,0,16">
                                <TextBlock DockPanel.Dock="Top" Text="设置"
                                           FontSize="22" FontWeight="SemiBold" Margin="24,0,0,22" />
                                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                                            Margin="24,0,0,0">
                                    <Path Data="M4,8 L4,3 L9,6 C10.9,5.2 13.1,5.2 15,6 L20,3 L20,8 C21.3,9.6 22,11.6 22,13.5 C22,17.6 17.5,21 12,21 C6.5,21 2,17.6 2,13.5 C2,11.6 2.7,9.6 4,8 Z M8.5,12 L8.6,12 M15.4,12 L15.5,12 M12,13.4 L12,15 M10.2,16.4 C11,17.2 13,17.2 13.8,16.4 M6,13 L3,12 M6,15 L3.4,16.2 M18,13 L21,12 M18,15 L20.6,16.2"
                                          Style="{DynamicResource CatIcon}" />
                                    <TextBlock Text="开心桌宠" FontSize="12"
                                               Foreground="{DynamicResource FurMutedBrush}"
                                               Margin="8,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>

                                <ListBox x:Name="NavList"
                                         Style="{DynamicResource NavListBox}"
                                         ItemContainerStyle="{DynamicResource NavItem}"
                                         SelectionChanged="OnNavSelectionChanged">
                                    <ListBoxItem AutomationProperties.Name="常规">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="M3,11 L12,3 L21,11 M5,10 L5,20 L19,20 L19,10 M9,20 L9,14 L15,14 L15,20"
                                                  Style="{DynamicResource LineIcon}" />
                                            <TextBlock Text="常规" Margin="11,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </ListBoxItem>
                                    <ListBoxItem AutomationProperties.Name="番茄钟">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="M4,13 A8,8 0 0 1 20,13 A8,8 0 0 1 4,13 M12,9 L12,13 L15,15 M9,2 L15,2 M12,2 L12,5"
                                                  Style="{DynamicResource LineIcon}" />
                                            <TextBlock Text="番茄钟" Margin="11,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </ListBoxItem>
                                    <ListBoxItem AutomationProperties.Name="音效">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="M5,9 L9,9 L14,5 L14,19 L9,15 L5,15 Z M17,9 C18.5,10.5 18.5,13.5 17,15 M19,6 C22,9 22,15 19,18"
                                                  Style="{DynamicResource LineIcon}" />
                                            <TextBlock Text="音效" Margin="11,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </ListBoxItem>
                                    <ListBoxItem AutomationProperties.Name="行为">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="M8,5 L19,12 L8,19 Z" Style="{DynamicResource LineIcon}" />
                                            <TextBlock Text="行为" Margin="11,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </ListBoxItem>
                                    <ListBoxItem AutomationProperties.Name="关于">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="M4,12 A8,8 0 0 1 20,12 A8,8 0 0 1 4,12 M12,11 L12,17 M12,7 L12.01,7"
                                                  Style="{DynamicResource LineIcon}" />
                                            <TextBlock Text="关于" Margin="11,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </ListBoxItem>
                                </ListBox>
                            </DockPanel>
                        </Border>

                        <!-- Content -->
                        <ScrollViewer x:Name="ContentScroll" Grid.Column="1"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Padding="28,22,28,28">
                            <Grid>
                                <!-- General -->
                                <StackPanel x:Name="GeneralSection">
                                    <Grid Margin="0,0,0,18">
                                        <StackPanel>
                                            <TextBlock Text="常规" Style="{DynamicResource PageTitle}" />
                                            <TextBlock Text="让开心以最舒服的方式陪着你。" Style="{DynamicResource PageSubtitle}" />
                                        </StackPanel>
                                        <Path  HorizontalAlignment="Right" VerticalAlignment="Top"
                                              Data="M40,7 C19,8 8,17 10,31 C12,42 25,43 32,35 C39,27 37,16 40,7 Z M8,41 C15,29 22,23 33,16 M17,29 L16,20 M24,23 L32,24"
                                              Style="{DynamicResource LeafIcon}" Opacity="0.8">
                                            <Path.RenderTransform>
                                                <RotateTransform Angle="8" CenterX="21" CenterY="21" />
                                            </Path.RenderTransform>
                                        </Path>
                                    </Grid>

                                    <Border Style="{DynamicResource WashCard}">
                                        <StackPanel>
                                            <TextBlock Text="桌宠" Style="{DynamicResource CardTitle}" />
                                            <TextBlock Text="宠物名字" Style="{DynamicResource FieldLabel}" />
                                            <TextBox x:Name="PetNameBox" Style="{DynamicResource PaperTextBox}"
                                                     MaxLength="24" LostFocus="OnPetNameCommitted"
                                                     KeyDown="OnPetNameKeyDown"
                                                     AutomationProperties.Name="宠物名字" />
                                            <TextBlock x:Name="PetNameError" Style="{DynamicResource ErrorText}" />
                                            <TextBlock Text="显示在托盘提示和右键菜单中，1–24 个字符。"
                                                       Style="{DynamicResource HintText}" />

                                            <CheckBox x:Name="TopmostCheck" Style="{DynamicResource SwitchCheckBox}"
                                                      Margin="0,14,0,0"
                                                      AutomationProperties.Name="始终置顶"
                                                      Checked="OnGeneralToggleChanged" Unchecked="OnGeneralToggleChanged">
                                                <StackPanel>
                                                    <TextBlock Text="始终置顶" Style="{DynamicResource ToggleTitle}" />
                                                    <TextBlock Text="让开心留在其他窗口上方" Style="{DynamicResource ToggleDescription}" />
                                                </StackPanel>
                                            </CheckBox>
                                            <CheckBox x:Name="HideFullscreenCheck" Style="{DynamicResource SwitchCheckBox}"
                                                      Margin="0,10,0,0"
                                                      AutomationProperties.Name="全屏应用时隐藏桌宠"
                                                      Checked="OnGeneralToggleChanged" Unchecked="OnGeneralToggleChanged">
                                                <StackPanel>
                                                    <TextBlock Text="全屏应用时隐藏桌宠" Style="{DynamicResource ToggleTitle}" />
                                                    <TextBlock Text="进入全屏后安静等待，计时继续" Style="{DynamicResource ToggleDescription}" />
                                                </StackPanel>
                                            </CheckBox>
                                            <CheckBox x:Name="LaunchAtLoginCheck" Style="{DynamicResource SwitchCheckBox}"
                                                      Margin="0,10,0,0"
                                                      AutomationProperties.Name="开机启动"
                                                      Checked="OnLaunchAtLoginChanged" Unchecked="OnLaunchAtLoginChanged">
                                                <StackPanel>
                                                    <TextBlock Text="开机启动" Style="{DynamicResource ToggleTitle}" />
                                                    <TextBlock Text="仅当前 Windows 用户" Style="{DynamicResource ToggleDescription}" />
                                                </StackPanel>
                                            </CheckBox>
                                            <TextBlock x:Name="LaunchAtLoginError" Style="{DynamicResource ErrorText}" />
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{DynamicResource PaperCard}">
                                        <StackPanel>
                                            <TextBlock Text="位置" Style="{DynamicResource CardTitle}" />
                                            <TextBlock Text="把开心放回当前显示器右下角，并记住新位置。"
                                                       Style="{DynamicResource HintText}" />
                                            <Border Height="104" Margin="0,12,0,0" CornerRadius="10"
                                                    Background="{DynamicResource PositionDemoBrush}"
                                                    BorderBrush="{DynamicResource FurOutlineSoftBrush}"
                                                    BorderThickness="1" ClipToBounds="True">
                                                <Grid>
                                                    <TextBlock Text="工作区右下角" FontSize="11"
                                                               Foreground="{DynamicResource FurMutedBrush}"
                                                               Margin="18,16,0,0" VerticalAlignment="Top" />
                                                    <Border Height="1" Margin="18,0,18,14" VerticalAlignment="Bottom"
                                                            Background="#668F9F82" />
                                                     <Path Margin="0,0,24,12"
                                                          HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                          Data="M4,8 L4,3 L9,6 C10.9,5.2 13.1,5.2 15,6 L20,3 L20,8 C21.3,9.6 22,11.6 22,13.5 C22,17.6 17.5,21 12,21 C6.5,21 2,17.6 2,13.5 C2,11.6 2.7,9.6 4,8 Z M8.5,12 L8.6,12 M15.4,12 L15.5,12 M12,13.4 L12,15 M10.2,16.4 C11,17.2 13,17.2 13.8,16.4 M6,13 L3,12 M6,15 L3.4,16.2 M18,13 L21,12 M18,15 L20.6,16.2"
                                                          Style="{DynamicResource PositionCatIcon}" />
                                                </Grid>
                                            </Border>
                                            <Button x:Name="ResetPositionButton" Style="{DynamicResource PaperButton}"
                                                    HorizontalAlignment="Left" Margin="0,12,0,0"
                                                    AutomationProperties.Name="重置位置"
                                                    Click="OnResetPositionClicked">
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Data="M4,10 A8,8 0 1 1 6,17 M4,4 L4,10 L10,10"
                                                          Style="{DynamicResource LineIcon}" />
                                                    <TextBlock Text="重置位置" Margin="7,0,0,0" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- Pomodoro -->
                                <StackPanel x:Name="PomodoroSection" Visibility="Collapsed">
                                    <Grid Margin="0,0,0,18">
                                        <StackPanel>
                                            <TextBlock Text="番茄钟" Style="{DynamicResource PageTitle}" />
                                            <TextBlock Text="拖动出适合你的专注节奏。" Style="{DynamicResource PageSubtitle}" />
                                        </StackPanel>
                                        <Path  HorizontalAlignment="Right" VerticalAlignment="Top"
                                              Data="M40,7 C19,8 8,17 10,31 C12,42 25,43 32,35 C39,27 37,16 40,7 Z M8,41 C15,29 22,23 33,16 M17,29 L16,20 M24,23 L32,24"
                                              Style="{DynamicResource LeafIcon}" Opacity="0.8">
                                            <Path.RenderTransform>
                                                <RotateTransform Angle="8" CenterX="21" CenterY="21" />
                                            </Path.RenderTransform>
                                        </Path>
                                    </Grid>

                                    <Border Style="{DynamicResource WashCard}">
                                        <StackPanel>
                                            <TextBlock Text="一轮节奏" Style="{DynamicResource CardTitle}" />
                                            <TextBlock Text="新的时长会在下一个阶段开始时生效，当前计时不被打断。"
                                                       Style="{DynamicResource HintText}" />

                                            <WrapPanel x:Name="CycleSummaryPanel" Margin="0,12,0,0" VerticalAlignment="Center">
                                                <Border Background="{DynamicResource EyeWashBrush}" CornerRadius="8" Padding="9,5">
                                                    <TextBlock x:Name="CycleFocusText" FontSize="12" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource EyeDeepBrush}" Text="专注 25 分钟" />
                                                </Border>
                                                <TextBlock Text="→" Foreground="{DynamicResource FurMutedBrush}" Margin="7,0" VerticalAlignment="Center" />
                                                <Border Background="#EEE6DC" CornerRadius="8" Padding="9,5">
                                                    <TextBlock x:Name="CycleShortText" FontSize="12" FontWeight="SemiBold"
                                                               Foreground="#795F4D" Text="短休息 5 分钟" />
                                                </Border>
                                                <TextBlock Text="→" Foreground="{DynamicResource FurMutedBrush}" Margin="7,0" VerticalAlignment="Center" />
                                                <StackPanel x:Name="CycleRoundsPanel" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,2,0" />
                                                <TextBlock Text="→" Foreground="{DynamicResource FurMutedBrush}" Margin="7,0" VerticalAlignment="Center" />
                                                <Border Background="#EEE6DC" CornerRadius="8" Padding="9,5">
                                                    <TextBlock x:Name="CycleLongText" FontSize="12" FontWeight="SemiBold"
                                                               Foreground="#795F4D" Text="长休息 15 分钟" />
                                                </Border>
                                            </WrapPanel>

                                            <Grid Margin="0,16,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="115" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="84" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="专注时长" Style="{DynamicResource SliderLabel}" />
                                                <StackPanel Grid.Column="1" Margin="0,0,14,0">
                                                    <Slider x:Name="FocusMinutesSlider" Style="{DynamicResource WatercolorSlider}"
                                                            Minimum="1" Maximum="180" TickFrequency="1"
                                                            AutomationProperties.Name="专注时长（分钟）"
                                                            ValueChanged="OnPomodoroSliderChanged" />
                                                    <Grid Margin="0,1,0,0">
                                                        <TextBlock Text="1 分钟" Style="{DynamicResource SliderLimitText}" />
                                                        <TextBlock Text="180 分钟" Style="{DynamicResource SliderLimitText}" HorizontalAlignment="Right" />
                                                    </Grid>
                                                </StackPanel>
                                                <Border Grid.Column="2" Style="{DynamicResource ValueChip}">
                                                    <TextBlock x:Name="FocusMinutesValue" Style="{DynamicResource ValueChipText}" Text="25 分钟" />
                                                </Border>
                                            </Grid>

                                            <Grid Margin="0,14,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="115" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="84" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="短休息" Style="{DynamicResource SliderLabel}" />
                                                <StackPanel Grid.Column="1" Margin="0,0,14,0">
                                                    <Slider x:Name="ShortBreakSlider" Style="{DynamicResource WatercolorSlider}"
                                                            Minimum="1" Maximum="60" TickFrequency="1"
                                                            AutomationProperties.Name="短休息（分钟）"
                                                            ValueChanged="OnPomodoroSliderChanged" />
                                                    <Grid Margin="0,1,0,0">
                                                        <TextBlock Text="1 分钟" Style="{DynamicResource SliderLimitText}" />
                                                        <TextBlock Text="60 分钟" Style="{DynamicResource SliderLimitText}" HorizontalAlignment="Right" />
                                                    </Grid>
                                                </StackPanel>
                                                <Border Grid.Column="2" Style="{DynamicResource ValueChip}">
                                                    <TextBlock x:Name="ShortBreakValue" Style="{DynamicResource ValueChipText}" Text="5 分钟" />
                                                </Border>
                                            </Grid>

                                            <Grid Margin="0,14,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="115" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="84" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="长休息" Style="{DynamicResource SliderLabel}" />
                                                <StackPanel Grid.Column="1" Margin="0,0,14,0">
                                                    <Slider x:Name="LongBreakSlider" Style="{DynamicResource WatercolorSlider}"
                                                            Minimum="1" Maximum="60" TickFrequency="1"
                                                            AutomationProperties.Name="长休息（分钟）"
                                                            ValueChanged="OnPomodoroSliderChanged" />
                                                    <Grid Margin="0,1,0,0">
                                                        <TextBlock Text="1 分钟" Style="{DynamicResource SliderLimitText}" />
                                                        <TextBlock Text="60 分钟" Style="{DynamicResource SliderLimitText}" HorizontalAlignment="Right" />
                                                    </Grid>
                                                </StackPanel>
                                                <Border Grid.Column="2" Style="{DynamicResource ValueChip}">
                                                    <TextBlock x:Name="LongBreakValue" Style="{DynamicResource ValueChipText}" Text="15 分钟" />
                                                </Border>
                                            </Grid>

                                            <Grid Margin="0,14,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="115" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="84" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="长休息轮次" Style="{DynamicResource SliderLabel}" />
                                                <StackPanel Grid.Column="1" Margin="0,0,14,0">
                                                    <Slider x:Name="RoundsSlider" Style="{DynamicResource WatercolorSlider}"
                                                            Minimum="1" Maximum="12" TickFrequency="1"
                                                            AutomationProperties.Name="长休息轮次"
                                                            ValueChanged="OnPomodoroSliderChanged" />
                                                    <Grid Margin="0,1,0,0">
                                                        <TextBlock Text="1 个" Style="{DynamicResource SliderLimitText}" />
                                                        <TextBlock Text="12 个" Style="{DynamicResource SliderLimitText}" HorizontalAlignment="Right" />
                                                    </Grid>
                                                </StackPanel>
                                                <Border Grid.Column="2" Style="{DynamicResource ValueChip}">
                                                    <TextBlock x:Name="RoundsValue" Style="{DynamicResource ValueChipText}" Text="4 个专注" />
                                                </Border>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{DynamicResource PaperCard}">
                                        <StackPanel>
                                            <TextBlock Text="自动流转" Style="{DynamicResource CardTitle}" />
                                            <CheckBox x:Name="AutoStartBreaksCheck" Style="{DynamicResource SwitchCheckBox}"
                                                      Margin="0,4,0,0"
                                                      AutomationProperties.Name="专注结束后自动开始休息"
                                                      Checked="OnPomodoroToggleChanged" Unchecked="OnPomodoroToggleChanged">
                                                <TextBlock Text="专注结束后自动开始休息" Style="{DynamicResource ToggleTitle}" />
                                            </CheckBox>
                                            <Border Height="1" Margin="0,8" Background="{DynamicResource FurOutlineSoftBrush}" />
                                            <CheckBox x:Name="AutoStartFocusCheck" Style="{DynamicResource SwitchCheckBox}"
                                                      AutomationProperties.Name="休息结束后自动开始下一个专注"
                                                      Checked="OnPomodoroToggleChanged" Unchecked="OnPomodoroToggleChanged">
                                                <TextBlock Text="休息结束后自动开始下一个专注" Style="{DynamicResource ToggleTitle}" />
                                            </CheckBox>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{DynamicResource PaperCard}">
                                        <StackPanel>
                                            <TextBlock Text="显示与提醒" Style="{DynamicResource CardTitle}" />
                                            <CheckBox x:Name="ShowTimeCheck" Style="{DynamicResource SwitchCheckBox}" Margin="0,4,0,0"
                                                      AutomationProperties.Name="在沙漏上方显示时间"
                                                      Checked="OnPomodoroToggleChanged" Unchecked="OnPomodoroToggleChanged">
                                                <TextBlock Text="在沙漏上方显示时间" Style="{DynamicResource ToggleTitle}" />
                                            </CheckBox>
                                            <Border Height="1" Margin="0,8" Background="{DynamicResource FurOutlineSoftBrush}" />
                                            <CheckBox x:Name="ShowHoverCheck" Style="{DynamicResource SwitchCheckBox}"
                                                      AutomationProperties.Name="悬停时展开控制面板"
                                                      Checked="OnPomodoroToggleChanged" Unchecked="OnPomodoroToggleChanged">
                                                <TextBlock Text="悬停时展开控制面板" Style="{DynamicResource ToggleTitle}" />
                                            </CheckBox>
                                            <Border Height="1" Margin="0,8" Background="{DynamicResource FurOutlineSoftBrush}" />
                                            <CheckBox x:Name="NotificationsCheck" Style="{DynamicResource SwitchCheckBox}"
                                                      AutomationProperties.Name="显示托盘气泡通知"
                                                      Checked="OnPomodoroToggleChanged" Unchecked="OnPomodoroToggleChanged">
                                                <TextBlock Text="显示托盘气泡通知" Style="{DynamicResource ToggleTitle}" />
                                            </CheckBox>
                                            <Border Height="1" Margin="0,8" Background="{DynamicResource FurOutlineSoftBrush}" />
                                            <CheckBox x:Name="QuietCheck" Style="{DynamicResource SwitchCheckBox}"
                                                      AutomationProperties.Name="专注时保持安静"
                                                      Checked="OnPomodoroToggleChanged" Unchecked="OnPomodoroToggleChanged">
                                                <StackPanel>
                                                    <TextBlock Text="专注时保持安静" Style="{DynamicResource ToggleTitle}" />
                                                    <TextBlock Text="不自动玩耍，交互音效减半" Style="{DynamicResource ToggleDescription}" />
                                                </StackPanel>
                                            </CheckBox>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{DynamicResource PaperCard}">
                                        <StackPanel>
                                            <TextBlock Text="全局快捷键" Style="{DynamicResource CardTitle}" />
                                            <Grid Margin="0,4,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox x:Name="HotkeyBox" Style="{DynamicResource PaperTextBox}" IsReadOnly="True"
                                                         AutomationProperties.Name="全局快捷键" />
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0">
                                                    <Button x:Name="ChangeHotkeyButton" Content="更改"
                                                            Style="{DynamicResource PaperButton}" Click="OnChangeHotkeyClicked" />
                                                    <Button x:Name="ResetHotkeyButton" Content="恢复默认"
                                                            Style="{DynamicResource PaperButton}" Margin="8,0,0,0"
                                                            Click="OnResetHotkeyClicked" />
                                                </StackPanel>
                                            </Grid>
                                            <TextBlock x:Name="HotkeyHint" Style="{DynamicResource HintText}"
                                                       Text="点击“更改”后按下新的组合键，至少包含 Ctrl、Alt、Shift 或 Win 中的一个；Esc 取消。" />
                                            <TextBlock x:Name="HotkeyError" Style="{DynamicResource ErrorText}" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- Audio -->
                                <StackPanel x:Name="AudioSection" Visibility="Collapsed">
                                    <Grid Margin="0,0,0,18">
                                        <StackPanel>
                                            <TextBlock Text="音效" Style="{DynamicResource PageTitle}" />
                                            <TextBlock Text="把声音调到刚刚好的陪伴感。" Style="{DynamicResource PageSubtitle}" />
                                        </StackPanel>
                                        <Path  HorizontalAlignment="Right" VerticalAlignment="Top"
                                              Data="M40,7 C19,8 8,17 10,31 C12,42 25,43 32,35 C39,27 37,16 40,7 Z M8,41 C15,29 22,23 33,16 M17,29 L16,20 M24,23 L32,24"
                                              Style="{DynamicResource LeafIcon}" Opacity="0.8">
                                            <Path.RenderTransform>
                                                <RotateTransform Angle="8" CenterX="21" CenterY="21" />
                                            </Path.RenderTransform>
                                        </Path>
                                    </Grid>

                                    <Border Style="{DynamicResource WashCard}">
                                        <StackPanel>
                                            <CheckBox x:Name="MutedCheck" Style="{DynamicResource SwitchCheckBox}"
                                                      AutomationProperties.Name="全部静音"
                                                      Checked="OnMutedChanged" Unchecked="OnMutedChanged">
                                                <StackPanel>
                                                    <TextBlock Text="全部静音" Style="{DynamicResource ToggleTitle}" />
                                                    <TextBlock Text="保留每条音量的当前值，解除静音后恢复" Style="{DynamicResource ToggleDescription}" />
                                                </StackPanel>
                                            </CheckBox>

                                            <Grid Margin="0,16,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="115" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="84" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="主音量" Style="{DynamicResource SliderLabel}" />
                                                <StackPanel Grid.Column="1" Margin="0,0,14,0">
                                                    <Slider x:Name="MasterSlider" Style="{DynamicResource WatercolorSlider}"
                                                            Minimum="0" Maximum="100" TickFrequency="1"
                                                            AutomationProperties.Name="主音量" ValueChanged="OnVolumeChanged" />
                                                    <Grid Margin="0,1,0,0">
                                                        <TextBlock Text="0" Style="{DynamicResource SliderLimitText}" />
                                                        <TextBlock Text="100" Style="{DynamicResource SliderLimitText}" HorizontalAlignment="Right" />
                                                    </Grid>
                                                </StackPanel>
                                                <Border Grid.Column="2" Style="{DynamicResource ValueChip}">
                                                    <TextBlock x:Name="MasterValueText" Style="{DynamicResource ValueChipText}" Text="80%" />
                                                </Border>
                                            </Grid>

                                            <Grid Margin="0,14,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="115" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="84" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="音效音量" Style="{DynamicResource SliderLabel}" />
                                                <StackPanel Grid.Column="1" Margin="0,0,14,0">
                                                    <Slider x:Name="EffectsSlider" Style="{DynamicResource WatercolorSlider}"
                                                            Minimum="0" Maximum="100" TickFrequency="1"
                                                            AutomationProperties.Name="音效音量" ValueChanged="OnVolumeChanged" />
                                                    <Grid Margin="0,1,0,0">
                                                        <TextBlock Text="0" Style="{DynamicResource SliderLimitText}" />
                                                        <TextBlock Text="100" Style="{DynamicResource SliderLimitText}" HorizontalAlignment="Right" />
                                                    </Grid>
                                                </StackPanel>
                                                <Border Grid.Column="2" Style="{DynamicResource ValueChip}">
                                                    <TextBlock x:Name="EffectsValueText" Style="{DynamicResource ValueChipText}" Text="90%" />
                                                </Border>
                                            </Grid>

                                            <Grid Margin="0,14,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="115" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="84" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="呼噜音量" Style="{DynamicResource SliderLabel}" />
                                                <StackPanel Grid.Column="1" Margin="0,0,14,0">
                                                    <Slider x:Name="AmbientSlider" Style="{DynamicResource WatercolorSlider}"
                                                            Minimum="0" Maximum="100" TickFrequency="1"
                                                            AutomationProperties.Name="呼噜音量" ValueChanged="OnVolumeChanged" />
                                                    <Grid Margin="0,1,0,0">
                                                        <TextBlock Text="0" Style="{DynamicResource SliderLimitText}" />
                                                        <TextBlock Text="100" Style="{DynamicResource SliderLimitText}" HorizontalAlignment="Right" />
                                                    </Grid>
                                                </StackPanel>
                                                <Border Grid.Column="2" Style="{DynamicResource ValueChip}">
                                                    <TextBlock x:Name="AmbientValueText" Style="{DynamicResource ValueChipText}" Text="25%" />
                                                </Border>
                                            </Grid>

                                            <CheckBox x:Name="PurrDuringFocusCheck" Style="{DynamicResource SwitchCheckBox}"
                                                      Margin="0,14,0,0"
                                                      AutomationProperties.Name="专注时播放呼噜环境音"
                                                      Checked="OnPurrChanged" Unchecked="OnPurrChanged">
                                                <StackPanel>
                                                    <TextBlock Text="专注时播放呼噜环境音" Style="{DynamicResource ToggleTitle}" />
                                                    <TextBlock Text="切换时做 300ms 淡入淡出" Style="{DynamicResource ToggleDescription}" />
                                                </StackPanel>
                                            </CheckBox>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{DynamicResource PaperCard}">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="事件音效" Style="{DynamicResource CardTitle}" />
                                                    <TextBlock Text="支持 WAV、MP3、M4A、FLAC；导入时自动转码为 44.1kHz 单声道、去静音并归一化。单个文件 0.2–30 秒、不超过 30MB。"
                                                               Style="{DynamicResource HintText}" />
                                                </StackPanel>
                                                <Button x:Name="RestoreAllSoundsButton" Grid.Column="1" Content="全部还原默认"
                                                        Style="{DynamicResource PaperButton}" VerticalAlignment="Top"
                                                        Click="OnRestoreAllSoundsClicked" />
                                            </Grid>
                                            <StackPanel x:Name="SoundRowsPanel" Margin="0,8,0,0" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- Behavior -->
                                <StackPanel x:Name="BehaviorSection" Visibility="Collapsed">
                                    <Grid Margin="0,0,0,18">
                                        <StackPanel>
                                            <TextBlock Text="行为" Style="{DynamicResource PageTitle}" />
                                            <TextBlock Text="玩耍、安静和睡觉，都有自己的节奏。" Style="{DynamicResource PageSubtitle}" />
                                        </StackPanel>
                                        <Path  HorizontalAlignment="Right" VerticalAlignment="Top"
                                              Data="M40,7 C19,8 8,17 10,31 C12,42 25,43 32,35 C39,27 37,16 40,7 Z M8,41 C15,29 22,23 33,16 M17,29 L16,20 M24,23 L32,24"
                                              Style="{DynamicResource LeafIcon}" Opacity="0.8">
                                            <Path.RenderTransform>
                                                <RotateTransform Angle="8" CenterX="21" CenterY="21" />
                                            </Path.RenderTransform>
                                        </Path>
                                    </Grid>

                                    <Border Style="{DynamicResource WashCard}">
                                        <StackPanel>
                                            <CheckBox x:Name="SpontaneousPlayCheck" Style="{DynamicResource SwitchCheckBox}"
                                                      AutomationProperties.Name="允许开心的自发玩耍"
                                                      Checked="OnBehaviorToggleChanged" Unchecked="OnBehaviorToggleChanged">
                                                <StackPanel>
                                                    <TextBlock Text="允许开心的自发玩耍" Style="{DynamicResource ToggleTitle}" />
                                                    <TextBlock Text="关闭后保留下面设置的时长" Style="{DynamicResource ToggleDescription}" />
                                                </StackPanel>
                                            </CheckBox>
                                            <Grid Margin="0,16,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="115" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="84" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="玩耍最长时长" Style="{DynamicResource SliderLabel}" />
                                                <StackPanel Grid.Column="1" Margin="0,0,14,0">
                                                    <Slider x:Name="PlayMaxSlider" Style="{DynamicResource WatercolorSlider}"
                                                            Minimum="10" Maximum="300" TickFrequency="1"
                                                            AutomationProperties.Name="玩耍最长时长（秒）"
                                                            ValueChanged="OnBehaviorSliderChanged" />
                                                    <Grid Margin="0,1,0,0">
                                                        <TextBlock Text="10 秒" Style="{DynamicResource SliderLimitText}" />
                                                        <TextBlock Text="300 秒" Style="{DynamicResource SliderLimitText}" HorizontalAlignment="Right" />
                                                    </Grid>
                                                </StackPanel>
                                                <Border Grid.Column="2" Style="{DynamicResource ValueChip}">
                                                    <TextBlock x:Name="PlayMaxValue" Style="{DynamicResource ValueChipText}" Text="90 秒" />
                                                </Border>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{DynamicResource PaperCard}">
                                        <StackPanel>
                                            <TextBlock Text="安静与睡眠" Style="{DynamicResource CardTitle}" />
                                            <Grid Margin="0,12,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="115" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="84" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="待机多久后入睡" Style="{DynamicResource SliderLabel}" />
                                                <StackPanel Grid.Column="1" Margin="0,0,14,0">
                                                    <Slider x:Name="SleepAfterSlider" Style="{DynamicResource WatercolorSlider}"
                                                            Minimum="1" Maximum="240" TickFrequency="1"
                                                            AutomationProperties.Name="待机后入睡时间（分钟）"
                                                            ValueChanged="OnBehaviorSliderChanged" />
                                                    <Grid Margin="0,1,0,0">
                                                        <TextBlock Text="1 分钟" Style="{DynamicResource SliderLimitText}" />
                                                        <TextBlock Text="240 分钟" Style="{DynamicResource SliderLimitText}" HorizontalAlignment="Right" />
                                                    </Grid>
                                                </StackPanel>
                                                <Border Grid.Column="2" Style="{DynamicResource ValueChip}">
                                                    <TextBlock x:Name="SleepAfterValue" Style="{DynamicResource ValueChipText}" Text="15 分钟" />
                                                </Border>
                                            </Grid>

                                            <Grid Margin="0,14,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="115" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="84" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="专注后进入安静" Style="{DynamicResource SliderLabel}" />
                                                <StackPanel Grid.Column="1" Margin="0,0,14,0">
                                                    <Slider x:Name="FocusQuietSlider" Style="{DynamicResource WatercolorSlider}"
                                                            Minimum="0" Maximum="60" TickFrequency="1"
                                                            AutomationProperties.Name="专注安静延迟（分钟）"
                                                            ValueChanged="OnBehaviorSliderChanged" />
                                                    <Grid Margin="0,1,0,0">
                                                        <TextBlock Text="立即" Style="{DynamicResource SliderLimitText}" />
                                                        <TextBlock Text="60 分钟" Style="{DynamicResource SliderLimitText}" HorizontalAlignment="Right" />
                                                    </Grid>
                                                </StackPanel>
                                                <Border Grid.Column="2" Style="{DynamicResource ValueChip}">
                                                    <TextBlock x:Name="FocusQuietValue" Style="{DynamicResource ValueChipText}" Text="2 分钟" />
                                                </Border>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- About -->
                                <StackPanel x:Name="AboutSection" Visibility="Collapsed">
                                    <Grid Margin="0,0,0,18">
                                        <StackPanel>
                                            <TextBlock Text="关于" Style="{DynamicResource PageTitle}" />
                                            <TextBlock Text="一只安静陪你工作的桌面小猫。" Style="{DynamicResource PageSubtitle}" />
                                        </StackPanel>
                                        <Path  HorizontalAlignment="Right" VerticalAlignment="Top"
                                              Data="M40,7 C19,8 8,17 10,31 C12,42 25,43 32,35 C39,27 37,16 40,7 Z M8,41 C15,29 22,23 33,16 M17,29 L16,20 M24,23 L32,24"
                                              Style="{DynamicResource LeafIcon}" Opacity="0.8">
                                            <Path.RenderTransform>
                                                <RotateTransform Angle="8" CenterX="21" CenterY="21" />
                                            </Path.RenderTransform>
                                        </Path>
                                    </Grid>

                                    <Border Style="{DynamicResource WashCard}">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="86" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Width="86" Height="98" CornerRadius="48,52,46,54"
                                                        Background="{DynamicResource EyeWashBrush}">
                                                    <Path Data="M14,25 L12,8 L26,17 A30,30 0 0 1 38,17 L52,8 L50,25 C54,30 56,36 55,42 C53,52 44,57 32,57 C20,57 11,52 9,42 C8,36 10,30 14,25 Z M20,34 L20.01,34 M44,34 L44.01,34 M27,43 C30,46 34,46 37,43 M32,39 L32,43 M18,40 L5,38 M18,45 L4,47 M46,40 L59,38 M46,45 L60,47"
                                                          Style="{DynamicResource PortraitIcon}" />
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="开心桌宠" FontSize="18" FontWeight="SemiBold" />
                                                    <TextBlock x:Name="VersionText" Style="{DynamicResource HintText}" />
                                                    <TextBlock Text="所有数据都在本机，不联网。"
                                                               Style="{DynamicResource HintText}" Margin="0,2,0,0" />
                                                </StackPanel>
                                            </Grid>
                                            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                                <Button Style="{DynamicResource PaperButton}" Click="OnOpenDataClicked"
                                                        AutomationProperties.Name="打开数据目录">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Path Data="M3,6 L10,6 L12,8 L21,8 L21,19 L3,19 Z"
                                                              Style="{DynamicResource LineIcon}" />
                                                        <TextBlock Text="打开数据目录" Margin="7,0,0,0" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Button>
                                                <Button Style="{DynamicResource PaperButton}"
                                                        Margin="8,0,0,0" Click="OnOpenLogsClicked"
                                                        AutomationProperties.Name="打开日志目录">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Path Data="M3,6 L10,6 L12,8 L21,8 L21,19 L3,19 Z"
                                                              Style="{DynamicResource LineIcon}" />
                                                        <TextBlock Text="打开日志目录" Margin="7,0,0,0" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Button>
                                                <Button Content="第三方许可" Style="{DynamicResource PaperButton}"
                                                        Margin="8,0,0,0" Click="OnOpenLicensesClicked"
                                                        AutomationProperties.Name="第三方许可" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{DynamicResource PaperCard}">
                                        <StackPanel>
                                            <TextBlock Text="重置" Style="{DynamicResource CardTitle}" />
                                            <TextBlock Text="恢复所有设置为默认值，并删除已导入的自定义音效缓存。此操作不可撤销。"
                                                       Style="{DynamicResource HintText}" />
                                            <Button x:Name="ResetAllButton" Content="重置所有设置"
                                                    Style="{DynamicResource DangerButton}"
                                                    HorizontalAlignment="Left" Margin="0,12,0,0"
                                                    Click="OnResetAllClicked" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
