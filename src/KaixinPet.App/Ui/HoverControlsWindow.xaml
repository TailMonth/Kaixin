<Window x:Class="KaixinPet.App.Ui.HoverControlsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="开心控制"
        Width="92" Height="30"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        Topmost="True"
        Focusable="False"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">

    <Window.Resources>
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#1A4A443C" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#2A4A443C" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="8"
            Background="#F2F7F2E8"
            BorderBrush="#1A2B2A27"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="8" ShadowDepth="1" Direction="270"
                              Opacity="0.16" Color="#000000" />
        </Border.Effect>

        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
            <Button x:Name="PauseButton"
                    Style="{StaticResource IconButton}"
                    Click="OnPauseClicked"
                    ToolTip="暂停 / 继续">
                <Grid Width="16" Height="16">
                    <StackPanel x:Name="PauseBars"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <Border Width="3" Height="11" Background="#4A443C" Margin="0,0,3,0" CornerRadius="1" />
                        <Border Width="3" Height="11" Background="#4A443C" CornerRadius="1" />
                    </StackPanel>
                    <Path x:Name="PlayIcon"
                          Data="M 4,2 L 14,8 L 4,14 Z"
                          Fill="#4A443C"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Visibility="Collapsed" />
                </Grid>
            </Button>

            <Button Style="{StaticResource IconButton}"
                    Click="OnSkipClicked"
                    ToolTip="跳过当前阶段">
                <Path Data="M 3,3 L 12,8 L 3,13 Z M 13,3 L 15,3 L 15,13 L 13,13 Z"
                      Fill="#4A443C"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center" />
            </Button>

            <Button Style="{StaticResource IconButton}"
                    Click="OnSettingsClicked"
                    ToolTip="打开设置文件目录">
                <Path Data="M 8,2 A 6,6 0 1 1 7.99,2 M 8,5 A 3,3 0 1 0 8.01,5 M 8,0 L 8,2 M 8,14 L 8,16 M 0,8 L 2,8 M 14,8 L 16,8"
                      Stroke="#4A443C"
                      StrokeThickness="1.4"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center" />
            </Button>
        </StackPanel>
    </Border>
</Window>
